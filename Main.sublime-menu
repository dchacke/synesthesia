[
    {
        "id": "tools",
        "children": [
            {
                "caption": "Synesthete",
                "children": [
                    { "caption": "Enabled", "command": "synesthete_toggle", "checkbox": true },
                    { "caption": "-" },
                    { "caption": "Listen to File", "command": "synesthete_set", "args": { "key": "listen_to", "value": "file" }, "checkbox": true },
                    { "caption": "Listen to Project", "command": "synesthete_set", "args": { "key": "listen_to", "value": "project" }, "checkbox": true },
                    { "caption": "-" },
                    { "caption": "Ambient", "command": "synesthete_set", "args": { "key": "mode", "value": "ambient" }, "checkbox": true },
                    { "caption": "Chime", "command": "synesthete_set", "args": { "key": "mode", "value": "chime" }, "checkbox": true },
                    { "caption": "-" },
                    { "caption": "Play Now", "command": "synesthete_play" },
                    { "caption": "Explain Score", "command": "synesthete_explain" },
                    { "caption": "Show Map", "command": "synesthete_map" },
                    { "caption": "Open Visualizer", "command": "synesthete_visualizer" },
                    { "caption": "Play All Stages", "command": "synesthete_demo" }
                ]
            }
        ]
    },
    {
        "id": "preferences",
        "children": [
            {
                "caption": "Package Settings",
                "id": "package-settings",
                "children": [
                    {
                        "caption": "Synesthete",
                        "children": [
                            {
                                "caption": "Settings",
                                "command": "edit_settings",
                                "args": {
                                    "base_file": "${packages}/Synesthete/Synesthete.sublime-settings",
                                    "default": "{\n\t$0\n}\n"
                                }
                            },
                            {
                                "caption": "Key Bindings",
                                "command": "edit_settings",
                                "args": {
                                    "base_file": "${packages}/Synesthete/Default.sublime-keymap",
                                    "user_file": "${packages}/User/Default ($platform).sublime-keymap",
                                    "default": "[\n\t$0\n]\n"
                                }
                            }
                        ]
                    }
                ]
            }
        ]
    }
]
