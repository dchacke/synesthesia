[
    {
        "id": "tools",
        "children": [
            {
                "caption": "Synesthesia",
                "children": [
                    { "caption": "Enabled", "command": "synesthesia_toggle", "checkbox": true },
                    { "caption": "-" },
                    { "caption": "Listen to File", "command": "synesthesia_set", "args": { "key": "listen_to", "value": "file" }, "checkbox": true },
                    { "caption": "Listen to Project", "command": "synesthesia_set", "args": { "key": "listen_to", "value": "project" }, "checkbox": true },
                    { "caption": "-" },
                    { "caption": "Ambient", "command": "synesthesia_set", "args": { "key": "mode", "value": "ambient" }, "checkbox": true },
                    { "caption": "Chime", "command": "synesthesia_set", "args": { "key": "mode", "value": "chime" }, "checkbox": true },
                    { "caption": "-" },
                    { "caption": "Play Now", "command": "synesthesia_play" },
                    { "caption": "Explain Score", "command": "synesthesia_explain" },
                    { "caption": "Show Map", "command": "synesthesia_map" },
                    { "caption": "Play All Stages", "command": "synesthesia_demo" }
                ]
            }
        ]
    },
    {
        "id": "preferences",
        "children": [
            {
                "caption": "Package Settings",
                "id": "package-settings",
                "children": [
                    {
                        "caption": "Synesthesia",
                        "command": "edit_settings",
                        "args": {
                            "base_file": "${packages}/Synesthesia/Synesthesia.sublime-settings",
                            "default": "{\n\t$0\n}\n"
                        }
                    }
                ]
            }
        ]
    }
]
