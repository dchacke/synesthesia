{
    // Master switch. "Synesthete: Toggle" flips it.
    "enabled": true,

    // What to listen to:
    // "file":    the file you are looking at, as you type, or the window's
    //            project while no code file is open.
    // "project": every source file in the window's folders, as they change
    //            on disk. Made for hearing a coding agent work without
    //            watching any particular file.
    "listen_to": "file",

    // How to play it:
    // "ambient": a continuous stream of phrases in the current stage, plus
    //            an accent whenever something changes.
    // "chime":   only the accents, and a phrase when the stage changes.
    "mode": "ambient",

    // Loudness from 0.0 to 1.0, for accents and phrases, and for the
    // ambient stream.
    "volume": 0.5,
    "ambient_volume": 0.3,

    // Milliseconds to wait after the last keystroke before listening again.
    "idle_delay": 300,

    // Views and files to listen to. Anything else (prose, panels) is
    // ignored, and the sound keeps describing the last code it heard.
    "selector": "source",

    // Bugs: scopes that syntax definitions mark as code they cannot parse,
    // and brackets that never close (outside strings and comments).
    "error_selector": "invalid - invalid.deprecated",
    "check_brackets": true,
    "ignore_selector": "string, comment",

    // Quality: where functions start, what counts as a branch, and the
    // limits past which code counts as messy.
    "function_selector": "entity.name.function",
    "branch_selector": "keyword.control.conditional, keyword.control.loop, keyword.control.exception.catch, keyword.operator.logical",
    "max_function_lines": 40,
    "max_branches": 10,
    "max_nesting": 4,
    // null means the view's widest ruler, or 100 if it has none. URLs, which
    // can't be broken, don't count toward a line's length.
    "max_line_length": null,

    // Languages' own parsers, which catch broken code that syntax
    // highlighting misses. Each gets the code on stdin and fails if it
    // doesn't parse; a file that doesn't parse counts as three bugs. None of
    // these run the code. Tools are looked up on your login shell's PATH.
    // node can't parse JSX, so remove it if your .js files contain JSX.
    "syntax_checkers": [
        { "selector": "source.ruby", "command": ["ruby", "-c"] },
        { "selector": "source.python", "command": ["python3", "-c", "import ast, sys; ast.parse(sys.stdin.read())"] },
        { "selector": "source.js", "command": ["node", "--check", "--input-type=module"] },
        { "selector": "source.shell.bash", "command": ["bash", "-n"] },
        { "selector": "source.php", "command": ["php", "-l"] }
    ],

    // Show the stage in the status bar.
    "show_status": true,

    // Files with more characters than this are ignored.
    "max_file_size": 2000000,

    // Project mode: seconds between checks for changed files, how many
    // files to watch at most, and what to skip besides what git ignores,
    // like generated lockfiles that would otherwise count as code.
    "poll_interval": 0.5,
    "max_project_files": 2000,
    "project_exclude": ["node_modules", "vendor", "dist", "build", "target", ".venv", "venv", "__pycache__", "coverage",
                        "package-lock.json", "npm-shrinkwrap.json"]
}
